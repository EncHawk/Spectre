# Neatlogs ingest (tracing). Ingest credentials do not grant Public API reads.
NEATLOGS_API_KEY=
# Neatlogs Public API service-account token and bound project UUID.
NEATLOGS_TOKEN=
NEATLOGS_PROJECT_ID=
NEATLOGS_HOST=https://app.neatlogs.com
# EU ingest only: https://eu.ingest.neatlogs.com
NEATLOGS_INGEST_ENDPOINT=

# Amazon Bedrock (standard AWS credential chain is also supported).
AWS_REGION=us-east-1
HEALER_BEDROCK_MODEL=amazon.nova-lite-v1:0
