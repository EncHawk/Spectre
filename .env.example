# Neatlogs ingest (tracing). Ingest credentials do not grant Public API reads.
NEATLOGS_API_KEY=
# Neatlogs Public API service-account token and bound project UUID.
NEATLOGS_TOKEN=
NEATLOGS_PROJECT_ID=
NEATLOGS_HOST=https://app.neatlogs.com
# EU ingest only: https://eu.ingest.neatlogs.com
NEATLOGS_INGEST_ENDPOINT=

# Pick one provider. HEALER_MODEL is a shared fallback for the provider-specific model variables.
HEALER_PROVIDER=openai
HEALER_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

GROQ_API_KEY=
GROQ_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# GOOGLE_API_KEY takes precedence; GEMINI_API_KEY is also supported by Google's SDK.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_MODEL=

# Hosted HTTP service. Generate a strong random value outside git.
HEALER_SERVER_TOKEN=
HEALER_HOST=0.0.0.0
HEALER_PORT=8080
HEALER_LOCAL_LOG=.healer/runs.jsonl
HEALER_REPO_PATH=.
HEALER_RESOLUTION_LOG=.healer/resolutions.jsonl
HEALER_REPO_REGISTRY=.healer/repositories

# Next.js control plane (server-only; set these in frontend/.env.local for development).
SPECTRE_PUBLIC_URL=http://localhost:3000
SPECTRE_DB_PATH=.spectre/control.sqlite
# Generate with: openssl rand -hex 32. Keep stable; rotating it disconnects GitHub tokens.
SPECTRE_ENCRYPTION_KEY=
SPECTRE_ALLOWED_EMAIL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
HEALER_API_URL=http://127.0.0.1:8080
