# Required for live competitor discovery and company research.
PARALLEL_API_KEY=

# Optional: pass --openai-model MODEL to rank candidate leads with OpenAI.
# To test Spectre's repair proposals, set HEALER_PROVIDER=openai and HEALER_MODEL
# to a model available to your OpenAI account, along with OPENAI_API_KEY.
OPENAI_API_KEY=
HEALER_PROVIDER=
HEALER_MODEL=

# Optional: send Spectre agent/tool traces to Neatlogs.
# The ingest key does not grant Public API read access.
NEATLOGS_API_KEY=

# Optional: read Neatlogs traces for `healer scan`/`healer doctor`.
# Supply both a project-bound service-account token and its project ID.
# The token needs context:read and observability:read permissions.
NEATLOGS_TOKEN=
NEATLOGS_PROJECT_ID=

# Change these only if your Neatlogs project is in the EU region.
NEATLOGS_HOST=https://app.neatlogs.com
NEATLOGS_INGEST_ENDPOINT=
