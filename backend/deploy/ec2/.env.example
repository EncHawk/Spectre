# Immutable ECR image reference is preferred, for example .../spectre-healer@sha256:...
HEALER_IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/spectre-healer:latest

# Generate outside git: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
HEALER_SERVER_TOKEN=

HEALER_PROVIDER=openai
HEALER_MODEL=gpt-5-mini
OPENAI_API_KEY=

# Set only the provider key selected above. Alternatives:
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

NEATLOGS_API_KEY=
NEATLOGS_TOKEN=
NEATLOGS_PROJECT_ID=
NEATLOGS_HOST=https://app.neatlogs.com
